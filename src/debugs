use macroquad::prelude::*;

/// Debug overlays toggled with F1-F5.
#[derive(Default)]
pub struct DebugPage {
    visible: bool,
    show_mouse: bool,
    show_grid: bool,
    show_hit_areas: bool,
    show_game_state: bool,
}

impl DebugPage {
    /// Toggle the matching debug option when a function key is pressed.
    pub fn update(&mut self) {
        if is_key_pressed(KeyCode::F1) { self.visible = !self.visible; }
        if is_key_pressed(KeyCode::F2) { self.show_mouse = !self.show_mouse; }
        if is_key_pressed(KeyCode::F3) { self.show_grid = !self.show_grid; }
        if is_key_pressed(KeyCode::F4) { self.show_hit_areas = !self.show_hit_areas; }
        if is_key_pressed(KeyCode::F5) { self.show_game_state = !self.show_game_state; }
    }

    /// Draw the enabled debugging information over the current page.
    pub fn draw(&self, font: &Font) {
        if !self.visible { return; }
        if self.show_grid { self.draw_grid(); }
        if self.show_hit_areas { self.draw_hit_areas(); }
        if self.show_mouse { self.draw_mouse_position(); }
        self.draw_panel(font);
    }

    /// Draw a 50-pixel coordinate grid over the screen.
    fn draw_grid(&self) {
        let color = Color::new(0.15, 0.45, 0.75, 0.25);
        let mut x = 0.0;
        while x <= screen_width() {
            draw_line(x, 0.0, x, screen_height(), 1.0, color);
            x += 50.0;
        }
        let mut y = 0.0;
        while y <= screen_height() {
            draw_line(0.0, y, screen_width(), y, 1.0, color);
            y += 50.0;
        }
    }

    /// Outline UI regions and lightly tint a region while the pointer is over it.
    fn draw_hit_areas(&self) {
        let width = screen_width().min(1320.0);
        let left = (screen_width() - width) * 0.5;
        let panel_y = 124.0 + 108.0;
        let main_width = width * 0.66;
        let side_x = left + main_width + 24.0;
        let side_width = width - main_width - 24.0;
        let red = Color::new(0.95, 0.2, 0.15, 0.8);
        let button = (left + 52.0, panel_y + 328.0, main_width - 104.0, 48.0);

        self.draw_hover_region(left, panel_y, main_width, 402.0, red);
        self.draw_hover_region(side_x, panel_y, side_width, 402.0, red);
        self.draw_hover_region(button.0, button.1, button.2, button.3, YELLOW);
    }

    /// Draw an outline, adding a very faint fill if the mouse is inside the rectangle.
    fn draw_hover_region(&self, x: f32, y: f32, width: f32, height: f32, color: Color) {
        let (mouse_x, mouse_y) = mouse_position();
        if mouse_x >= x && mouse_x <= x + width && mouse_y >= y && mouse_y <= y + height {
            draw_rectangle(x, y, width, height, Color::new(color.r, color.g, color.b, 0.08));
        }
        draw_rectangle_lines(x, y, width, height, 2.0, color);
    }

    /// Mark the mouse position and show its screen coordinates.
    fn draw_mouse_position(&self) {
        let (x, y) = mouse_position();
        draw_circle(x, y, 5.0, RED);
        draw_line(x - 10.0, y, x + 10.0, y, 1.5, RED);
        draw_line(x, y - 10.0, x, y + 10.0, 1.5, RED);
        draw_text(&format!("({x:.0}, {y:.0})"), x + 12.0, y - 10.0, 18.0, RED);
    }

    /// Show the toggle states and a small snapshot of the current page state.
    fn draw_panel(&self, font: &Font) {
        let (x, y, width) = (18.0, 18.0, 340.0);
        let height = if self.show_game_state { 218.0 } else { 172.0 };
        let (mouse_x, mouse_y) = mouse_position();
        let hovered = mouse_x >= x && mouse_x <= x + width
            && mouse_y >= y && mouse_y <= y + height;
        let opacity = if hovered { 0.25 } else { 1.0 };
        draw_rectangle(x, y, width, height, Color::new(0.05, 0.07, 0.1, 0.88 * opacity));
        let mut border = SKYBLUE;
        border.a *= opacity;
        draw_rectangle_lines(x, y, width, height, 1.0, border);
        let mut title_color = WHITE;
        title_color.a *= opacity;
        draw_text_ex("DEBUG PAGE", x + 14.0, y + 27.0, TextParams {
            font: Some(font), font_size: 20, color: title_color, ..Default::default()
        });

        let rows = [
            ("F1", "Debug display", self.visible),
            ("F2", "Mouse position", self.show_mouse),
            ("F3", "Grid", self.show_grid),
            ("F4", "UI regions", self.show_hit_areas),
            ("F5", "Game state", self.show_game_state),
        ];
        for (index, (key, label, enabled)) in rows.iter().enumerate() {
            let row_y = y + 53.0 + index as f32 * 23.0;
            let state = if *enabled { "ON" } else { "OFF" };
            let mut color = if *enabled { LIME } else { GRAY };
            color.a *= opacity;
            draw_text_ex(&format!("{key}  {label}: {state}"), x + 14.0, row_y, TextParams {
                font: Some(font), font_size: 16, color, ..Default::default()
            });
        }

        if self.show_game_state {
            draw_text_ex(&format!("Page: Wiki top    FPS: {}", get_fps()), x + 14.0, y + 193.0, TextParams {
                font: Some(font), font_size: 14, color: title_color, ..Default::default()
            });
        }
    }
}
